# Deployed frontend origin, merged into CORS allow-list alongside local dev ports.
# No ETL_ prefix — matches the env var name you'd set in Vercel project settings.
FRONTEND_URL=https://veryon-sheet-sorter.vercel.app

# Everything below is optional (sensible defaults already set in app/core/config.py),
# prefixed with ETL_ per model_config(env_prefix="ETL_").
# ETL_MAX_UPLOAD_SIZE_BYTES=10485760
# ETL_SAMPLE_ROW_COUNT=20
# ETL_UPLOAD_DIR=/tmp/veryon-etl/uploads
# ETL_OUTPUT_DIR=/tmp/veryon-etl/output
